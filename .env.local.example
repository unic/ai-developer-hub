# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/dbname?sslmode=require"

# NextAuth v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL is the canonical app URL used by NextAuth for cookie domain and redirects.
# Set this to your app's public URL when needed; on Vercel preview deployments it may be overridden automatically.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# API Key Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=""

# Cloudflare R2 (invoice PDF storage)
# Account ID: Cloudflare dashboard → top-right corner
# API Token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write on invoice bucket)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="invoice-pdfs"

# Anthropic (Claude Haiku invoice field extraction)
ANTHROPIC_API_KEY=""

# Anthropic Admin API Key (workspace sync and global cost reporting)
# Required for workspace sync and global cost reporting (Anthropic Admin API key — distinct from the regular API key)
ANTHROPIC_ADMIN_API_KEY=""
# Anthropic API version (default: 2023-06-01)
ANTHROPIC_API_VERSION="2023-06-01"

# Vercel Cron Job Authentication (min 16 chars)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Bearer token for POST /api/invoices/ingest (external automation ingestion endpoint).
# Min 16 chars; recommend `openssl rand -base64 32`.
INVOICE_INGEST_SECRET=""

# Bearer token for POST /api/license-requests/ingest (spec 032 — license request automation).
# Power Automate calls this endpoint when a Microsoft Form is submitted.
# Min 16 chars; recommend `openssl rand -base64 32`.
LICENSE_REQUEST_INGEST_SECRET=""

# Microsoft Graph (spec 032) — Entra app registration filed in IT-112678.
# Needed for outbound channel replies + group chat messages from the Hub to Teams.
# Required permissions: ChannelMessage.Send, ChatMessage.Send (application, admin-consented).
# If any of these are unset, the Hub will skip Graph posts gracefully — the request
# state machine still works, but Teams notifications won't go out.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# Resend (transactional email service for invite emails)
RESEND_API_KEY="re_xxxxxxxxxxxxx"
# Sender email address (must be verified in Resend dashboard)
FROM_EMAIL="noreply@yourdomain.com"

# User id of the admin who owns automated/API-initiated invoice ingestion operations.
# REQUIRED at startup (validateEnv() rejects empty / non-numeric values).
# Must reference an active admin user (role=admin, status=active); the live DB
# check happens lazily on first use.
# To find your admin's id after seeding: SELECT id, email FROM users WHERE role='admin' AND status='active';
SYSTEM_ADMIN_USER_ID=""

# Nighthawk agent session (local dev + preview deployments only)
# Bearer secret for the /api/agent/session mint route. Set this if you want to
# exercise the route locally or on a Vercel preview. The nighthawk workflow
# does NOT need a repo-level secret — it generates a fresh one per run inside
# the runner so the value never reaches the agent's container.
# Generate with: openssl rand -base64 32
# IMPORTANT: must NOT be set on the Production env. The mint route refuses
# production requests; not setting the secret there is defense in depth.
AGENT_SESSION_SECRET=""
# Email of the seeded agent user (created by `pnpm db:seed:agent`).
AGENT_USER_EMAIL="nighthawk@agent.local"
# Optional: comma-separated extra deny entries on top of BUILT_IN_DENY_PATHS.
# Format: "/path" or "METHOD /path", e.g. "DELETE /api/users,/api/admin/dangerous"
AGENT_DENY_PATHS=""

# Profile API preview (optional — enables the API preview panel in Settings)
PROFILE_API_SECRET=""
# Vercel protection bypass secret (optional — used by the profile API preview to bypass Vercel auth)
VERCEL_AUTOMATION_BYPASS_SECRET=""

# Build-time escape hatch: set to "1" in CI builds where not all runtime vars are available.
# SKIP_ENV_VALIDATION=1
