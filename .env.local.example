# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# API Key Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=""

# Cloudflare R2 (invoice PDF storage)
# Account ID: Cloudflare dashboard → top-right corner
# API Token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write on invoice bucket)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="invoice-pdfs"

# Anthropic (Claude Haiku invoice field extraction)
ANTHROPIC_API_KEY=""

# Anthropic Admin API Key (workspace sync and global cost reporting)
# Required for workspace sync and global cost reporting (Anthropic Admin API key — distinct from the regular API key)
ANTHROPIC_ADMIN_API_KEY=""

# Vercel Cron Job Authentication
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Resend (transactional email service for invite emails)
RESEND_API_KEY="re_xxxxxxxxxxxxx"
# Sender email address (must be verified in Resend dashboard)
FROM_EMAIL="noreply@yourdomain.com"
